{
  "name": "html-forecaster",
  "version": "0.3.0",
  "description": "Plataforma de análisis y predicción probabilística de fútbol basada en evidencia estadística (Poisson, Dixon-Coles, Elo, modelo ponderado).",
  "main": "backend/server.js",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning backend/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch backend/server.js",
    "collect": "node --disable-warning=ExperimentalWarning backend/cli.js collect",
    "forecast": "node --disable-warning=ExperimentalWarning backend/cli.js forecast",
    "settle": "node --disable-warning=ExperimentalWarning backend/cli.js settle",
    "learn": "node --disable-warning=ExperimentalWarning backend/cli.js learn",
    "daily": "node --disable-warning=ExperimentalWarning backend/cli.js daily",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "test:e2e": "npx playwright test",
    "coverage": "node --disable-warning=ExperimentalWarning --experimental-test-coverage --test tests/*.test.js",
    "build:standalone": "node scripts/build-standalone.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "license": "MIT",
  "devDependencies": {
    "chart.js": "^4.4.1",
    "esbuild": "^0.24.2",
    "playwright": "^1.65.1",
    "sql.js": "^1.12.0",
    "tailwindcss": "^3.4.16"
  }
}
