# Puerto y host del servidor (por defecto solo localhost: los endpoints de recolección no tienen autenticación)
PORT=3000
HOST=127.0.0.1

# Zona horaria usada para decidir a qué "día" pertenece un partido
TIMEZONE=America/Bogota

# Ruta de la base de datos SQLite
DB_PATH=./data/forecaster.db

# Proveedor de datos activo: sofascore | football-data | api-football
DATA_PROVIDER=sofascore
# Respaldo automático si el principal falla (vacío = sin respaldo)
FALLBACK_PROVIDER=

# football-data.org — clave gratuita en https://www.football-data.org/client/register
# (plan gratuito: resultados y calendario; SIN estadísticas, cuotas ni H2H)
FOOTBALL_DATA_API_KEY=
# IDs de football-data (NO son los de Sofascore): 2021 Premier, 2016 Championship, 2014 LaLiga,
# 2002 Bundesliga, 2019 Serie A, 2015 Ligue 1, 2001 Champions League
FOOTBALL_DATA_COMPETITIONS=2021,2016,2014,2002,2019,2015,2001

# API-Football (api-sports.io) — plan gratuito 100 peticiones/día
API_FOOTBALL_API_KEY=
# IDs de API-Football: 39 Premier, 40 Championship, 140 LaLiga, 78 Bundesliga, 135 Serie A, 61 Ligue 1, 2 UCL, 3 UEL, 848 UECL
API_FOOTBALL_LEAGUES=39,40,140,78,135,61,2,3,848
# Primera temporada que permite el plan (el gratuito solo accede a 2022–2024)
API_FOOTBALL_SEASON_START=2024

# Temporadas completas a cargar en el histórico inicial (npm run bootstrap), 1–5
BOOTSTRAP_SEASONS=2
SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1

# Milisegundos mínimos entre peticiones (respetar al proveedor)
REQUEST_INTERVAL_MS=450
REQUEST_RETRIES=3
REQUEST_TIMEOUT_MS=15000

# Profundidad del histórico
HISTORY_DEPTH=20        # partidos por equipo para goles/forma (máx. 50)
STATS_DEPTH=10          # partidos por equipo con estadísticas (corners/tarjetas)
H2H_STATS_DEPTH=5       # enfrentamientos directos con estadísticas

# IDs de "uniqueTournament" de SOFASCORE separados por coma (vacío = todos). Solo aplican a Sofascore.
# Ej.: 17=Premier League, 8=LaLiga, 23=Serie A, 35=Bundesliga, 34=Ligue 1, 7=Champions League
TOURNAMENTS=17,18,8,35,23,34,7,679,17015
# Máximo de partidos a procesar por día (0 = sin límite)
MAX_MATCHES=0

# Presupuesto por ciclo de recolección (el plan gratuito de API-Football permite 100 peticiones/día).
# Se deja margen para reintentos; al agotarse, el ciclo termina con los datos ya obtenidos.
MAX_REQUESTS_PER_RUN=85
# Estadísticas nuevas (corners/tarjetas/xG) por ciclo
MAX_STATS_PER_RUN=25
# Si el equipo ya tiene un partido en la base más reciente que estos días, no se repite su histórico
TEAM_HISTORY_MAX_AGE_DAYS=3

# Planificador interno (cron simplificado): 1 = activo
SCHEDULER_ENABLED=0

LOG_LEVEL=info

# Token opcional para las acciones POST de la API (vacío = sin token, solo localhost)
API_TOKEN=

# WhatsApp Web (tu propia cuenta, sin APIs): número de DESTINO con código de país, solo dígitos.
# El botón «Enviar por WhatsApp» abre web.whatsapp.com con el mensaje escrito; tú pulsas Enter.
WHATSAPP_WEB_TO=

# WhatsApp API oficial (opcional, envío 100 % automático; requiere número de WhatsApp Business):
# resumen diario del Top 10 y apuestas de valor
WHATSAPP_ENABLED=0
# 1 = enviar automáticamente tras el ciclo diario del planificador
WHATSAPP_AUTO=0
WHATSAPP_PROVIDER=meta
WHATSAPP_TO=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
